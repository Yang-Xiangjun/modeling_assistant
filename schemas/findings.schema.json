        "pass": {
          "default": 0,
          "title": "Pass",
          "type": "integer"
        },
        "review": {
          "default": 0,
          "title": "Review",
          "type": "integer"
        },
        "warn": {
          "default": 0,
          "title": "Warn",
          "type": "integer"
        }
      },
      "title": "FindingsSummary",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "op": {
          "const": "flag",
          "default": "flag",
          "title": "Op",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
