        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "op": {
          "const": "add_dimension",
          "default": "add_dimension",
          "title": "Op",
          "type": "string"
        },
        "view_id": {
          "title": "View Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "view_id"
      ],
      "title": "AddDimension",
      "type": "object"
    },
    "AddView": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "op": {
          "const": "add_view",
          "default": "add_view",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "candidate_id"
      ],
      "title": "AddView",
      "type": "object"
    },
    "FindingResult": {
      "additionalProperties": false,
      "properties": {
        "edits": {
          "items": {
            "discriminator": {
              "mapping": {
                "add_dimension": "#/$defs/AddDimension",
                "add_view": "#/$defs/AddView",
                "flag": "#/$defs/Flag",
                "move_dimension": "#/$defs/MoveDimension",
                "move_view": "#/$defs/MoveView",
                "remove_dimension": "#/$defs/RemoveDimension",
                "set_sheet": "#/$defs/SetSheet",
                "set_view_scale": "#/$defs/SetViewScale",
                "switch_view": "#/$defs/SwitchView"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MoveDimension"
              },
              {
                "$ref": "#/$defs/MoveView"
              },
              {
                "$ref": "#/$defs/SetViewScale"
              },
              {
                "$ref": "#/$defs/SetSheet"
              },
              {
                "$ref": "#/$defs/AddDimension"
              },
              {
                "$ref": "#/$defs/RemoveDimension"
              },
              {
                "$ref": "#/$defs/SwitchView"
              },
              {
                "$ref": "#/$defs/AddView"
              },
              {
                "$ref": "#/$defs/Flag"
              }
            ]
          },
          "title": "Edits",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "review"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "status",
        "message"
      ],
      "title": "FindingResult",
      "type": "object"
    },
    "FindingsSummary": {
