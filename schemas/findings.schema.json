      "title": "SetSheet",
      "type": "object"
    },
    "SetViewScale": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "op": {
          "const": "set_view_scale",
          "default": "set_view_scale",
          "title": "Op",
          "type": "string"
        },
        "scale": {
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "id",
        "scale"
      ],
      "title": "SetViewScale",
      "type": "object"
    },
    "SwitchView": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "title": "Dimension Id",
          "type": "string"
        },
        "op": {
          "const": "switch_view",
          "default": "switch_view",
          "title": "Op",
          "type": "string"
